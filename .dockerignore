# .dockerignore
# Keep build context small — exclude anything not needed inside the image.

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/.venv
**/venv
**/*.egg-info

# Dev / IDE
.git
.gitignore
.env
.env.*
!.env.example
.DS_Store
*.swp
*.swo

# Docs
docs/
*.md
!README.md

# Test artifacts
**/.pytest_cache
**/htmlcov
**/.coverage
**/coverage.xml

# Local data (mounted as volumes at runtime, never baked into the image)
data/
eval/

# Logs
*.log
uvicorn.log
streamlit.log

# Scripts for local dev only
up.sh
down.sh
