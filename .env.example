# .env.example
# Copy to .env and adjust values if needed — no secrets or API keys required.
#
#   cp .env.example .env
#
# All paths are relative to the repository root.
# up.sh and the application read these at startup via python-dotenv.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

API_HOST=0.0.0.0                        # host the FastAPI server binds to
API_PORT=8000                           # port the FastAPI server listens on
API_LOG_LEVEL=warning                   # uvicorn log level: debug info warning error

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

STREAMLIT_PORT=8501                     # port the Streamlit dashboard listens on
STREAMLIT_HOST=0.0.0.0                  # host the Streamlit server binds to

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:8501      # comma-separated list of allowed origins

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

RATE_LIMIT=100/minute                   # max requests per IP per window (slowapi format)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_PATH=data/search_logs.db             # SQLite database file for query logs

# ---------------------------------------------------------------------------
# Indexes
# ---------------------------------------------------------------------------

BM25_INDEX_DIR=data/indexes/bm25        # directory containing index.pkl and meta.json
VECTOR_INDEX_DIR=data/indexes/vector    # directory containing index.faiss, meta.json, id_map.json

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------

DOCS_PATH=data/processed/docs.jsonl    # processed Wikipedia articles in JSONL format
RAW_DOCS_DIR=data/raw                  # drop .txt files here to include in ingest

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------

QRELS_PATH=eval/qrels.json             # ground-truth relevance judgments
METRICS_DIR=data/metrics               # evaluation outputs e.g. experiments.csv

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------

INGEST_MAX_ARTICLES=20                 # max Wikipedia articles fetched per category
INGEST_MAX_CHARS=3000                  # truncate each article text to this many characters
INGEST_REQUEST_DELAY=0.05              # seconds to wait between Wikipedia API requests

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------

EMBEDDING_MODEL=all-MiniLM-L6-v2       # sentence-transformers model name
EMBEDDING_DEVICE=cpu                   # cpu only — do not set to cuda